# --- Anthropic (text compression + structured extraction) ---
ANTHROPIC_API_KEY=
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5
ANTHROPIC_EXTRACT_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=16000
ANTHROPIC_CHEAP_MAX_TOKENS=8192

# --- OpenAI (draft vision + final vision; fallback text tiers) ---
OPENAI_API_KEY=
OPENAI_CHEAP_MODEL=gpt-4o-mini
OPENAI_EXTRACT_MODEL=gpt-4.1-2025-04-14
OPENAI_DRAFT_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

PUBCHEM_USER_AGENT=DataCon2026/1.0

# Routing (automatic):
#   Both keys  → Haiku → GPT-4o-mini → Opus 4.8 → GPT-4o
#   Anthropic  → Haiku → Opus (vision via Anthropic)
#   OpenAI     → GPT-4o-mini → GPT-4.1 → GPT-4o
#   Neither    → error
